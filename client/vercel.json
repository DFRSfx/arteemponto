{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/produtos/:path*",
      "destination": "https://cdn.arteemponto.pt/produtos/:path*"
    },
    {
      "source": "/hero-slides/:path*",
      "destination": "https://cdn.arteemponto.pt/hero-slides/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
