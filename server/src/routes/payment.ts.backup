import express from 'express';
import { body, validationResult } from 'express-validator';

const router = express.Router();

// Eupago credentials - supports both API Key and OAuth2
const EUPAGO_API_KEY = process.env.EUPAGO_API_KEY || '';
const EUPAGO_CLIENT_ID = process.env.EUPAGO_CLIENT_ID || '';
const EUPAGO_CLIENT_SECRET = process.env.EUPAGO_CLIENT_SECRET || '';
const EUPAGO_BASE_URL = process.env.EUPAGO_BASE_URL || 'https://clientes.eupago.pt/api/v1.02';

// Helper function to get authentication header
function getAuthHeader(): string {
  if (EUPAGO_API_KEY) {
    // Using API Key (chave)
    return `ApiKey ${EUPAGO_API_KEY}`;
  } else if (EUPAGO_CLIENT_ID && EUPAGO_CLIENT_SECRET) {
    // Using OAuth2 Client Credentials
    const credentials = Buffer.from(`${EUPAGO_CLIENT_ID}:${EUPAGO_CLIENT_SECRET}`).toString('base64');
    return `Basic ${credentials}`;
  } else {
    throw new Error('Eupago credentials not configured. Set EUPAGO_API_KEY or EUPAGO_CLIENT_ID + EUPAGO_CLIENT_SECRET');
  }
}

// Helper function to get chave for Multibanco (direct API calls)
function getChave(): string {
  if (EUPAGO_API_KEY) {
    return EUPAGO_API_KEY;
  } else if (EUPAGO_CLIENT_ID) {
    // For OAuth2, the chave is the Client ID
    return EUPAGO_CLIENT_ID;
  } else {
    throw new Error('Eupago credentials not configured');
  }
}

// Generate Multibanco reference
router.post(
  '/multibanco',
  [
    body('amount').isFloat({ min: 0.01 }).withMessage('Amount must be positive'),
    body('email').isEmail().withMessage('Valid email is required'),
    body('order_id').isInt().withMessage('Order ID is required')
  ],
  async (req, res) => {
    try {
      const errors = validationResult(req);
      if (!errors.isEmpty()) {
        res.status(400).json({ errors: errors.array() });
        return;
      }

      const { amount, email, order_id, phone } = req.body;

      // Prepare request data according to Eupago docs
      const requestData = {
        chave: getChave(),
        valor: amount.toFixed(2),
        id: `ORDER-${order_id}-${Date.now()}`,
        per_dup: '0' // No duplicates allowed
      };

      const response = await fetch(`${EUPAGO_BASE_URL}/multibanco`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': getAuthHeader()
        },
        body: JSON.stringify(requestData)
      });

      const data = await response.json();

      if (!response.ok || data.estado === 'error') {
        console.error('Eupago error:', data);
        res.status(500).json({ 
          error: 'Failed to generate Multibanco reference', 
          details: data.resposta || data 
        });
        return;
      }

      // Response format from Eupago:
      // {
      //   "estado": "ok",
      //   "resposta": "ok",
      //   "entidade": "11249",
      //   "referencia": "100 000 001",
      //   "valor": "10.50",
      //   "chave": "xxxx-xxxx-xxxx-xxxx-xxxx"
      // }

      res.json({
        success: true,
        entity: data.entidade,
        reference: data.referencia,
        value: parseFloat(data.valor),
        identifier: requestData.id
      });
    } catch (error) {
      console.error('Error generating Multibanco reference:', error);
      res.status(500).json({ error: 'Failed to generate payment reference' });
    }
  }
);

// Generate MB WAY payment
router.post(
  '/mbway',
  [
    body('amount').isFloat({ min: 0.01 }).withMessage('Amount must be positive'),
    body('phone').trim().notEmpty().withMessage('Phone is required'),
    body('email').isEmail().withMessage('Valid email is required'),
    body('order_id').isInt().withMessage('Order ID is required')
  ],
  async (req, res) => {
    try {
      const errors = validationResult(req);
      if (!errors.isEmpty()) {
        res.status(400).json({ errors: errors.array() });
        return;
      }

      const { amount, phone, email, order_id } = req.body;

      // Remove spaces and validate Portuguese phone number
      const cleanPhone = phone.replace(/\s+/g, '');
      
      // Format phone number - remove country code if present
      let formattedPhone = cleanPhone;
      if (formattedPhone.startsWith('+351')) {
        formattedPhone = formattedPhone.substring(4);
      } else if (formattedPhone.startsWith('351')) {
        formattedPhone = formattedPhone.substring(3);
      } else if (formattedPhone.startsWith('00351')) {
        formattedPhone = formattedPhone.substring(5);
      }

      // Validate Portuguese mobile number (9 digits starting with 9)
      if (!/^9\d{8}$/.test(formattedPhone)) {
        res.status(400).json({ error: 'Número de telemóvel inválido. Use formato: 912345678' });
        return;
      }

      // Prepare request data according to Eupago docs
      // IMPORTANT: MB WAY uses different structure than other methods!
      const requestData = {
        payment: {
          identifier: `ORDER-${order_id}-${Date.now()}`,
          amount: {
            value: parseFloat(amount.toFixed(2)), // Must be a number, not string
            currency: 'EUR'
          },
          customerPhone: formattedPhone,  // Phone goes HERE in payment object
          countryCode: '+351'              // Required country code
        },
        customer: {
          notify: true,
          email: email
        }
      };

      console.log('MB WAY Request:', JSON.stringify(requestData, null, 2));

      const response = await fetch(`${EUPAGO_BASE_URL}/mbway`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': getAuthHeader()
        },
        body: JSON.stringify(requestData)
      });

      const contentType = response.headers.get('content-type');
      console.log('Response status:', response.status);
      console.log('Response content-type:', contentType);

      // Check if response is JSON
      if (!contentType || !contentType.includes('application/json')) {
        const text = await response.text();
        console.error('Non-JSON response:', text);
        res.status(500).json({ 
          error: 'Invalid response from Eupago', 
          details: text.substring(0, 200) 
        });
        return;
      }

      const data = await response.json();
      console.log('MB WAY Response:', data);

      if (!response.ok || data.estado === 'error') {
        console.error('Eupago MB WAY error:', data);
        res.status(500).json({ 
          error: 'Failed to generate MB WAY payment', 
          details: data.resposta || data 
        });
        return;
      }

      // Response format from Eupago
      res.json({
        success: true,
        transactionId: data.transactionID || data.id,
        status: data.estado,
        message: 'Verifique a sua app MB WAY para autorizar o pagamento',
        identifier: requestData.payment.identifier
      });
    } catch (error: any) {
      console.error('Error generating MB WAY payment:', error);
      res.status(500).json({ 
        error: 'Failed to generate MB WAY payment',
        message: error.message 
      });
    }
  }
);

// Generate Credit Card payment
router.post(
  '/credit-card',
  [
    body('amount').isFloat({ min: 0.01 }).withMessage('Amount must be positive'),
    body('email').isEmail().withMessage('Valid email is required'),
    body('order_id').isInt().withMessage('Order ID is required')
  ],
  async (req, res) => {
    try {
      const errors = validationResult(req);
      if (!errors.isEmpty()) {
        res.status(400).json({ errors: errors.array() });
        return;
      }

      const { amount, email, order_id } = req.body;

      // Prepare request data according to Eupago docs
      const requestData = {
        payment: {
          amount: {
            currency: 'EUR',
            value: amount.toFixed(2)
          },
          lang: 'PT',
          minutesFormUp: 1440, // 24 hours
          identifier: `ORDER-${order_id}-${Date.now()}`,
          successUrl: `${process.env.FRONTEND_URL || 'http://localhost:5173'}/checkout?payment=success`,
          failUrl: `${process.env.FRONTEND_URL || 'http://localhost:5173'}/checkout?payment=failed`,
          backUrl: `${process.env.FRONTEND_URL || 'http://localhost:5173'}/carrinho`
        },
        customer: {
          notify: true,
          email: email
        }
      };

      const response = await fetch(`${EUPAGO_BASE_URL}/creditcard`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': getAuthHeader()
        },
        body: JSON.stringify(requestData)
      });

      const data = await response.json();

      if (!response.ok || data.estado === 'error') {
        console.error('Eupago Credit Card error:', data);
        res.status(500).json({ 
          error: 'Failed to generate Credit Card payment', 
          details: data.resposta || data 
        });
        return;
      }

      res.json({
        success: true,
        paymentUrl: data.url, // URL to redirect user to payment form
        transactionId: data.transactionID || data.id,
        identifier: requestData.payment.identifier
      });
    } catch (error) {
      console.error('Error generating Credit Card payment:', error);
      res.status(500).json({ error: 'Failed to generate Credit Card payment' });
    }
  }
);

// Webhook to receive payment notifications from Eupago
router.post('/webhook', async (req, res) => {
  try {
    console.log('Eupago webhook received:', req.body);

    const {
      transactionID,
      referencia,
      valor,
      identificador,
      canal,
      estado,
      mp_token, // Token for validation
      mp_id,
      mp_entity,
      mp_reference,
      mp_value
    } = req.body;

    // TODO: Validate webhook authenticity using mp_token

    // Extract order ID from identificador
    const orderIdMatch = identificador?.match(/ORDER-(\d+)-/) || identificador?.match(/ORDER-(\d+)$/);
    if (!orderIdMatch) {
      console.error('Invalid identifier format:', identificador);
      res.status(400).json({ error: 'Invalid identifier' });
      return;
    }

    const orderId = parseInt(orderIdMatch[1]);

    // Update order status based on payment status
    if (estado === 'ok' || estado === 'success' || estado === 'paid') {
      console.log(`✅ Payment confirmed for order ${orderId}`);
      // TODO: Update order status in database
      // await pool.query('UPDATE orders SET payment_status = ?, status = ? WHERE id = ?', 
      //   ['paid', 'processing', orderId]);
    } else if (estado === 'error' || estado === 'failed') {
      console.log(`❌ Payment failed for order ${orderId}`);
      // TODO: Update order status in database
      // await pool.query('UPDATE orders SET payment_status = ? WHERE id = ?', 
      //   ['failed', orderId]);
    }

    res.json({ success: true, message: 'Webhook processed' });
  } catch (error) {
    console.error('Error processing webhook:', error);
    res.status(500).json({ error: 'Failed to process webhook' });
  }
});

// Check payment status
router.get('/status/:identifier', async (req, res) => {
  try {
    const { identifier } = req.params;

    // Eupago doesn't have a direct status endpoint in the docs
    // You'll need to check your Eupago dashboard or use webhooks
    // This is a placeholder endpoint
    
    res.json({ 
      message: 'Status check not implemented. Use webhooks for real-time updates.',
      identifier 
    });
  } catch (error) {
    console.error('Error checking payment status:', error);
    res.status(500).json({ error: 'Failed to check payment status' });
  }
});

export default router;
